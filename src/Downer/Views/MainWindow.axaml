<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        x:Class="Downer.Views.MainWindow"
        Title="Downer"
        Width="1200" Height="780"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource ChromeBackground}" />
      <Setter Property="Padding" Value="4,1" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="MenuNew" Header="_New" Click="OnNew" />
        <MenuItem x:Name="MenuOpen" Header="_Open…" Click="OnOpen" />
        <MenuItem x:Name="RecentMenu" Header="Open _Recent" IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="MenuSave" Header="_Save" Click="OnSave" />
        <MenuItem x:Name="MenuSaveAs" Header="Save _As…" Click="OnSaveAs" />
        <Separator />
        <MenuItem Header="_Export as HTML…" Click="OnExportHtml" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="MenuUndo" Header="_Undo" Click="OnUndo" />
        <MenuItem x:Name="MenuRedo" Header="_Redo" Click="OnRedo" />
        <Separator />
        <MenuItem x:Name="MenuCut" Header="Cu_t" Click="OnCut" />
        <MenuItem x:Name="MenuCopy" Header="_Copy" Click="OnCopy" />
        <MenuItem x:Name="MenuPaste" Header="_Paste" Click="OnPaste" />
        <Separator />
        <MenuItem x:Name="MenuSelectAll" Header="Select _All" Click="OnSelectAll" />
        <Separator />
        <MenuItem x:Name="MenuFind" Header="_Find…" Click="OnFind" />
        <MenuItem x:Name="MenuReplace" Header="R_eplace…" Click="OnReplace" />
      </MenuItem>
      <MenuItem Header="F_ormat">
        <MenuItem x:Name="MenuBold" Header="_Bold" Click="OnBold" />
        <MenuItem x:Name="MenuItalic" Header="_Italic" Click="OnItalic" />
        <MenuItem x:Name="MenuStrike" Header="_Strikethrough" Click="OnStrikethrough" />
        <MenuItem x:Name="MenuInlineCode" Header="Inline _Code" Click="OnInlineCode" />
        <Separator />
        <MenuItem Header="_Heading">
          <MenuItem Header="Heading _1" Click="OnHeading" Tag="1" />
          <MenuItem Header="Heading _2" Click="OnHeading" Tag="2" />
          <MenuItem Header="Heading _3" Click="OnHeading" Tag="3" />
          <MenuItem Header="Heading _4" Click="OnHeading" Tag="4" />
          <MenuItem Header="Heading _5" Click="OnHeading" Tag="5" />
          <MenuItem Header="Heading _6" Click="OnHeading" Tag="6" />
          <Separator />
          <MenuItem Header="_Clear Heading" Click="OnHeading" Tag="0" />
        </MenuItem>
        <Separator />
        <MenuItem x:Name="MenuBullet" Header="Bullet _List" Click="OnBulletList" />
        <MenuItem x:Name="MenuOrdered" Header="_Numbered List" Click="OnOrderedList" />
        <MenuItem x:Name="MenuTask" Header="_Task List" Click="OnTaskList" />
        <MenuItem x:Name="MenuQuote" Header="Block_quote" Click="OnBlockquote" />
      </MenuItem>
      <MenuItem Header="_Insert">
        <MenuItem x:Name="MenuLink" Header="_Link…" Click="OnInsertLink" />
        <MenuItem x:Name="MenuImage" Header="I_mage…" Click="OnInsertImage" />
        <Separator />
        <MenuItem Header="_Table" Click="OnInsertTable" />
        <MenuItem Header="Code _Block" Click="OnInsertCodeBlock" />
        <MenuItem Header="Horizontal _Rule" Click="OnInsertRule" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="MenuModeRich" Header="_Formatted Editing" Click="OnModeRich" ToggleType="Radio" IsChecked="True" />
        <MenuItem x:Name="MenuModeSource" Header="_Markdown Source" Click="OnModeSource" ToggleType="Radio" />
        <Separator />
        <MenuItem x:Name="MenuViewEditor" Header="_Editor Only" Click="OnViewEditor" ToggleType="Radio" />
        <MenuItem x:Name="MenuViewSplit" Header="_Split" Click="OnViewSplit" ToggleType="Radio" IsChecked="True" />
        <MenuItem x:Name="MenuViewPreview" Header="_Preview Only" Click="OnViewPreview" ToggleType="Radio" />
        <Separator />
        <MenuItem x:Name="MenuWordWrap" Header="_Word Wrap" Click="OnToggleWordWrap" ToggleType="CheckBox" IsChecked="True" />
        <MenuItem x:Name="MenuLineNumbers" Header="Line _Numbers" Click="OnToggleLineNumbers" ToggleType="CheckBox" IsChecked="True" />
        <Separator />
        <MenuItem x:Name="MenuZoomIn" Header="Zoom _In" Click="OnZoomIn" />
        <MenuItem x:Name="MenuZoomOut" Header="Zoom _Out" Click="OnZoomOut" />
        <MenuItem x:Name="MenuZoomReset" Header="_Reset Zoom" Click="OnZoomReset" />
        <Separator />
        <MenuItem Header="_Theme">
          <MenuItem x:Name="MenuThemeSystem" Header="_System" Click="OnThemeSystem" ToggleType="Radio" IsChecked="True" />
          <MenuItem x:Name="MenuThemeLight" Header="_Light" Click="OnThemeLight" ToggleType="Radio" />
          <MenuItem x:Name="MenuThemeDark" Header="_Dark" Click="OnThemeDark" ToggleType="Radio" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Welcome Guide" Click="OnWelcomeGuide" />
        <MenuItem Header="_About Downer" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ChromeBackground}"
            BorderBrush="{DynamicResource ChromeBorder}"
            BorderThickness="0,0,0,1"
            Padding="10,5">
      <StackPanel Orientation="Horizontal" Spacing="1">
        <StackPanel.Styles>
          <Style Selector="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
          </Style>
          <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChromeHover}" />
          </Style>
          <Style Selector="Button > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ToolIconBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
          <Style Selector="Button > Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{DynamicResource ToolIconBrush}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
          </Style>
          <Style Selector="Rectangle.sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="{DynamicResource ChromeBorder}" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </StackPanel.Styles>

        <Button Click="OnBold" ToolTip.Tip="Bold">
          <TextBlock Text="B" FontWeight="Bold" FontSize="14" />
        </Button>
        <Button Click="OnItalic" ToolTip.Tip="Italic">
          <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia, Times New Roman, serif" FontSize="14" />
        </Button>
        <Button Click="OnStrikethrough" ToolTip.Tip="Strikethrough">
          <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="14" />
        </Button>
        <Button Click="OnInlineCode" ToolTip.Tip="Inline code">
          <TextBlock Text="&lt;/&gt;" FontSize="11" />
        </Button>

        <Rectangle Classes="sep" />

        <Button Click="OnHeading" Tag="1" ToolTip.Tip="Heading 1">
          <TextBlock Text="H1" />
        </Button>
        <Button Click="OnHeading" Tag="2" ToolTip.Tip="Heading 2">
          <TextBlock Text="H2" />
        </Button>
        <Button Click="OnHeading" Tag="3" ToolTip.Tip="Heading 3">
          <TextBlock Text="H3" />
        </Button>

        <Rectangle Classes="sep" />

        <Button Click="OnBulletList" ToolTip.Tip="Bullet list">
          <Path Fill="{DynamicResource ToolIconBrush}" StrokeThickness="0"
                Data="M3 4.5 m-1.2 0 a1.2 1.2 0 1 0 2.4 0 a1.2 1.2 0 1 0 -2.4 0 M3 8 m-1.2 0 a1.2 1.2 0 1 0 2.4 0 a1.2 1.2 0 1 0 -2.4 0 M3 11.5 m-1.2 0 a1.2 1.2 0 1 0 2.4 0 a1.2 1.2 0 1 0 -2.4 0 M6.5 3.8 H14 V5.2 H6.5 Z M6.5 7.3 H14 V8.7 H6.5 Z M6.5 10.8 H14 V12.2 H6.5 Z" />
        </Button>
        <Button Click="OnOrderedList" ToolTip.Tip="Numbered list">
          <TextBlock Text="1." />
        </Button>
        <Button Click="OnTaskList" ToolTip.Tip="Task list">
          <Path Data="M3 3.5 H13 V13.5 H3 Z M5.5 8.6 L7.4 10.5 L10.8 6.3" />
        </Button>
        <Button Click="OnBlockquote" ToolTip.Tip="Blockquote">
          <Path Fill="{DynamicResource ToolIconBrush}" StrokeThickness="0"
                Data="M4.6 4.5 Q3 7 4.9 11.5 L7.2 11.5 Q5.7 8.4 7 4.5 Z M10.2 4.5 Q8.6 7 10.5 11.5 L12.8 11.5 Q11.3 8.4 12.6 4.5 Z" />
        </Button>

        <Rectangle Classes="sep" />

        <Button Click="OnInsertLink" ToolTip.Tip="Insert link">
          <Path Data="M6.2 9.8 L9.8 6.2 M5.2 6.8 L3.9 8.1 A2.75 2.75 0 0 0 7.9 12.1 L9.2 10.8 M10.8 9.2 L12.1 7.9 A2.75 2.75 0 0 0 8.1 3.9 L6.8 5.2" />
        </Button>
        <Button Click="OnInsertImage" ToolTip.Tip="Insert image">
          <Path Data="M2.5 3.5 H13.5 V12.5 H2.5 Z M3.5 11.5 L6.8 8 L9.3 10.5 L11.2 8.8 L13.5 10.8 M10.4 6 a0.9 0.9 0 1 0 0.02 0" />
        </Button>
        <Button Click="OnInsertTable" ToolTip.Tip="Insert table">
          <Path Data="M2.5 3.5 H13.5 V12.5 H2.5 Z M2.5 6.7 H13.5 M6.2 3.5 V12.5 M9.9 3.5 V12.5" />
        </Button>
        <Button Click="OnInsertCodeBlock" ToolTip.Tip="Insert code block">
          <Path Data="M6 4.5 L3 8 L6 11.5 M10 4.5 L13 8 L10 11.5" />
        </Button>
        <Button Click="OnInsertRule" ToolTip.Tip="Horizontal rule">
          <Path Data="M3 8 H13" />
        </Button>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ChromeBackground}"
            BorderBrush="{DynamicResource ChromeBorder}"
            BorderThickness="0,1,0,0"
            Padding="12,5">
      <DockPanel>
        <DockPanel.Styles>
          <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
            <Setter Property="FontSize" Value="12" />
          </Style>
        </DockPanel.Styles>
        <TextBlock x:Name="PositionText" DockPanel.Dock="Right" Text="Ln 1, Col 1" Margin="18,0,0,0" />
        <TextBlock x:Name="CountsText" DockPanel.Dock="Right" Text="" Margin="18,0,0,0" />
        <TextBlock x:Name="ModeText" DockPanel.Dock="Right" Text="Formatted" Margin="18,0,0,0" FontWeight="SemiBold" />
        <TextBlock x:Name="FileText" Text="Untitled" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid x:Name="EditorGrid" ColumnDefinitions="*,4,*">
      <ae:TextEditor x:Name="Editor"
                     Grid.Column="0"
                     FontFamily="Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace"
                     FontSize="14"
                     ShowLineNumbers="False"
                     WordWrap="True"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto"
                     Padding="28,18" />
      <GridSplitter x:Name="PaneSplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
      <md:MarkdownScrollViewer x:Name="Preview"
                               Grid.Column="2"
                               SaveScrollValueWhenContentUpdated="True"
                               Margin="8,0,0,0" />
    </Grid>

  </DockPanel>
</Window>
